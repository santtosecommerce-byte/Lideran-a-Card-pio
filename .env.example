NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Configure later on the server only; never expose this secret with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Mercado Pago integration is intentionally not activated in this starter.
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Acesso da equipe ao painel (interino, até o Supabase Auth). Use valores longos e secretos.
STAFF_PASSWORD=
STAFF_SECRET=
